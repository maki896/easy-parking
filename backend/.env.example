# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/easyparking
# or for MongoDB Atlas: MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/easyparking

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_here_make_it_long_and_random
JWT_EXPIRE=7d

# Chapa Payment Gateway (Test Mode)
CHAPA_SECRET_KEY=CHASECK_TEST_xxxxxxxxxxxxxxxx
CHAPA_WEBHOOK_SECRET=your_webhook_secret_here

# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
FRONTEND_URL=http://localhost:3000
